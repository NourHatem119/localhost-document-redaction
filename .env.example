# Obscura — Cognee local/offline config (Person B, T1).
# Copy to `.env` in the project root. Cognee reads these automatically.
# Never commit the real .env.

# --- LLM: exo, OpenAI-compatible, on the demo machine (spec §2) ---
# exo serves the OpenAI API shape at :52415, so provider stays "openai".
LLM_PROVIDER="openai"
LLM_MODEL="openai/llama-3.2-3b"          # match the model exo actually loaded
LLM_ENDPOINT="http://localhost:52415/v1"
LLM_API_KEY="sk-local-exo"               # exo ignores it; must be non-empty

# --- Embeddings: Fastembed (local ONNX, CPU, no API key, fully offline) ---
# This is the offline win: no dependency on exo serving an embeddings route.
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS="384"               # all-MiniLM-L6-v2 is 384-dim

# --- Local small model: skip the LLM preflight so it doesn't time out ---
COGNEE_SKIP_CONNECTION_TEST="true"

# Graph + vector stores default to in-process (ladybug + lancedb) — no servers,
# no network. Override only if you know why.
# GRAPH_DATABASE_PROVIDER="ladybug"
# VECTOR_DB_PROVIDER="lancedb"
